import "alloc.och"
import "util.och"

struct Tape
  Int  feed_ptr
  Int  size
  ^Int feed

fun Tape.new(Int) [^Tape]
  Int size @size
  &size 8 * alloc cast:^Int
  <Tape> swp over @Tape.feed
  dup 0 swp @Tape.feed_ptr
  dup &size swp @Tape.size

fun Tape.get(^Tape) [Int]
  dup &Tape.feed swp &Tape.feed_ptr 8 *
  swp cast:Int + cast:^Int &Int

fun Tape.plus(^Tape)
  dup &Tape.feed swp &Tape.feed_ptr 8 *
  swp cast:Int + cast:^Int
  dup &Int 1 + 256 modulo swp @Int

fun Tape.minus(^Tape)
  dup &Tape.feed swp &Tape.feed_ptr 8 *
  swp cast:Int + cast:^Int
  dup &Int 1 - 256 modulo swp @Int

fun Tape.shift_by(Int ^Tape)
  swp over &Tape.feed_ptr +
  over &Tape.size modulo swp @Tape.feed_ptr

fun Tape.print(^Tape)
  Tape.get cast:Char
  Char x @x
  1 x 1 1 call3 pop

