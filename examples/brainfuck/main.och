import "tape.och"
import "util.och"

fun find_matching_start_bracket(^String Int) [Int]
  0 Int depth @depth
  swp ^String program @program
  loop:
    1 - &program &String.data over get_char_at_idx
    dup ']' = cjmpt inc
    dup '[' = cjmpt dec
    jmp next 
  inc: &depth 1 + @depth jmp next
  dec: &depth 1 - @depth
  next:
    pop &depth -1 != cjmpt loop

fun find_matching_end_bracket(^String Int) [Int]
  0 Int depth @depth
  swp ^String program @program
  loop:
    1 + &program &String.data over get_char_at_idx
    dup '[' = cjmpt inc
    dup ']' = cjmpt dec
    jmp next 
  inc: &depth 1 + @depth jmp next
  dec: &depth 1 - @depth
  next:
    pop &depth -1 != cjmpt loop

fun run_program(^Tape ^String) [^Tape ^String]
  ^String program @program
  ^Tape tape @tape
  0 Int idx @idx

  loop:
    &program &String.data &idx get_char_at_idx
    dup '+' = cjmpt plus
    dup '-' = cjmpt minus
    dup '.' = cjmpt print
    dup ',' = cjmpt read
    dup '>' = cjmpt shift_right
    dup '<' = cjmpt shift_left
    dup '[' = cjmpt start_loop
    dup ']' = cjmpt end_loop
    jmp next

    plus:          &tape Tape.plus     jmp next
    minus:         &tape Tape.minus    jmp next
    print:         &tape Tape.print    jmp next
    read:          &tape Tape.read     jmp next
    shift_right: 1 &tape Tape.shift_by jmp next
    shift_left: -1 &tape Tape.shift_by jmp next
    start_loop:
      &tape Tape.get 0 != cjmpt next
      &program &idx find_matching_end_bracket @idx
      jmp next
	end_loop:
      &tape Tape.get 0 = cjmpt next
      &program &idx find_matching_start_bracket @idx

    next:
      pop &idx 1 + @idx
      &idx &program &String.size < cjmpt loop
  &tape &program

fun main()
  30000 Tape.new
  "++++[>+++++<-]>[<+++++>-]+<+[>[>+>+<<-]++>>[<<+>>-]>>>[-]++>[-]+>>>+[[-]++++++>>>]<<<[[<++++++++<++>>-]+<.<[>----<-]<]<<[>>>>>[>>>[-]+++++++++<[>-<-]+++++++++>[-[<->-]+[<<<]]<[>+<-]>]<<-]<<-]"

  String.new run_program delete delete
