fun linear_fib(Int) [Int]
  Int i @i
  1 0 algo:
	&i 2 = cjmpet algo
    over + swp
	&i 1 - @i
	jmp algo
  end +
  
fun recursive_fib(Int) [Int]
  dup 0 != over 1 != and cjmpt recursion
  return
  recursion:
    dup 1 - recursive_fib
    swp 2 - recursive_fib +
  end

fun main()
  92 linear_fib dump
  40 recursive_fib dump
