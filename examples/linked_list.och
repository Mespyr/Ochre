struct Node
  Int data
  ^Node next

struct LinkedList
  Node head
  Int size

fun LinkedList.init(^LinkedList)
  0 swp @LinkedList.size

fun LinkedList.append(Int ^LinkedList)
  ^LinkedList LL @LL
  Int value @value
  &LL &LinkedList.size 0 != cjmpt append 

  &value &LL @LinkedList.head.data
  jmp end_append

  append:
    <Node> dup &value swp @Node.data
    &LL &LinkedList.head
    0 loop:
      dup &LL &LinkedList.size 1 - = cjmpt end_loop
      swp &Node.next
      swp 1 +
      jmp loop
    end_loop:
	  pop @Node.next
  end_append:
    &LL &LinkedList.size 1 + &LL @LinkedList.size

fun LinkedList.print(^LinkedList)
  LinkedList LL @LL
  &LL.head 0 loop:
    dup &LL.size = cjmpt end_loop
    swp dup &Node.data dump
    &Node.next # go to next node
    swp 1 +
    jmp loop
  end_loop: pop pop

fun LinkedList.pop(^LinkedList)
  ^LinkedList LL @LL
  &LL &LinkedList.head
  0 loop:
    dup &LL &LinkedList.size 1 - = cjmpt end_loop
    swp &Node.next
    swp 1 +
    jmp loop
  end_loop:
    pop delete
    &LL &LinkedList.size 1 - &LL @LinkedList.size

fun LinkedList.clear(^LinkedList)
  ^LinkedList LL @LL
  &LL &LinkedList.head &Node.next

  0 loop:
    dup &LL &LinkedList.size 1 - = cjmpt end_loop
    swp dup &Node.next
    swp delete
    swp 1 +
    jmp loop
  end_loop:
    pop pop 0 &LL @LinkedList.size

fun print(Int ^Char)
  1 1 call3 pop

fun main()
  LinkedList LL
  LL LinkedList.init

  12 LL LinkedList.append
  13 LL LinkedList.append
  14 LL LinkedList.append
  15 LL LinkedList.append
  16 LL LinkedList.append

  "First Linked List Iteration:\n" print
  LL LinkedList.print

  LL LinkedList.pop
  LL LinkedList.pop

  "Linked List Iteration After Popping:\n" print
  LL LinkedList.print

  LL LinkedList.clear

  "Size of Linked List After Clearing\n" print
  &LL.size dump
