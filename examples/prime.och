fun mod(Int Int) [Int] / swp pop
fun sq(Int) [Int] dup *

fun prime?(Int) [Int]
  1 swp 1
  loop:
    1 + over over sq < cjmpt end
    over over mod 0 != cjmpt loop
    rot pop 0 rot rot
  end: pop pop

fun main()
  0 loop:
    1 + dup prime? not cjmpt loop
    dup dump
    dup 10000 <= cjmpt loop
  pop
