fun mod(Int Int) [Int] / swp pop
fun puts(Int ^Char) 1 1 call3 pop

fun fizzbuzz(Int)
  dup 15 mod 0 != cjmpt mod3
    pop "FizzBuzz\n" puts return 0 # typechecker
  mod3: dup 3 mod 0 != cjmpt mod5
    pop "Fizz\n" puts return 0 # typechecker
  mod5: dup 5 mod 0 != cjmpt else
    pop "Buzz\n" puts return 0 # typechecker
  else: dump

fun main()
  1 loop:
    dup fizzbuzz
    1 + dup 100 <= cjmpt loop
  pop
